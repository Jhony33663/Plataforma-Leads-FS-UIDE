<?xml version="1.0" encoding="utf-8"?>
<!-- Servidor Institucional UIDE - Protección contra indexación (noindex, nofollow) -->
<configuration>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <add name="X-Robots-Tag" value="noindex, nofollow, noarchive, nosnippet, noimageindex" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="X-XSS-Protection" value="1; mode=block" />
            </customHeaders>
        </httpProtocol>
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="data" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
